# BabyBloom London — .gitignore (07 §7; 08 §2.1 step 0 (i); COMMIT-DISCIPLINE "what not to commit")

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# environment — every .env* except the generated example and the placeholder-only test fixture (06 §2.5; 05 §4.3)
.env
.env.*
!.env.example
!.env.test

# secrets / keys
*.pem
*.key
credentials.*
service-account*.json

# next.js / build output
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# vercel
.vercel

# testing artefacts (05 §10 — never committed; uploaded as CI artefacts only)
/coverage
lcov.info
/playwright-report
/blob-report
/test-results
/playwright/.cache
/tests/e2e/artifacts

# local supabase state
/supabase/.temp
/supabase/.branches

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# os / editor
.DS_Store
Thumbs.db
.idea
.vscode/*
!.vscode/extensions.json
