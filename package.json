{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "node scripts/generate-katie-manifest.mjs",
    "generate:manifest": "node scripts/generate-katie-manifest.mjs",
    "start": "next start",
    "lint": "next lint",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:db": "vitest run --project integration",
    "types:generate": "supabase gen types typescript --local > src/modules/shared-types/database.types.ts",
    "test:e2e": "playwright test",
    "test:shell-smoke": "bash scripts/ci/shell-smoke.sh",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:invites": "PLAYWRIGHT_TEST_INVITES_ENABLED=true playwright test tests/e2e/invite-flow-path-a.spec.ts tests/e2e/invite-flow-path-b.spec.ts tests/e2e/invite-flow-path-c.spec.ts tests/e2e/invite-flow-path-d.spec.ts tests/e2e/invite-landing.spec.ts --workers=1",
    "check:claude-md": "bash scripts/ci/check-claude-md.sh",
    "gen:boundary-rules": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gen-boundary-rules.ts",
    "check:allowed-imports": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gen-boundary-rules.ts --check",
    "lint:boundaries": "ESLINT_USE_FLAT_CONFIG=true eslint --config eslint.boundaries.js --max-warnings 0 \"src/modules/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\" \"scripts/boundaries/rules/**/*.js\"",
    "check:config-literals": "node scripts/ci/check-config-literals.mjs",
    "check:limiter-call-sites": "node scripts/ci/check-limiter-call-sites.mjs",
    "check:banned-words": "node scripts/ci/banned-words-static.mjs",
    "check:env-example": "npm run env:check",
    "check:env-reads": "node scripts/ci/check-env-reads.mjs",
    "check:pins": "node scripts/ci/check-exact-pins.mjs",
    "check:audit": "node scripts/ci/check-audit.mjs",
    "check:bundle-secrets": "node scripts/ci/scan-client-bundle.mjs",
    "check:prod-guard": "bash scripts/ci/prod-guard-boot.sh",
    "check:boot-guard": "bash scripts/ci/boot-guard.sh",
    "gates": "npm run typecheck && npm run lint && npm run check:allowed-imports && npm run check:limiter-call-sites && npm run lint:boundaries && npm test && npm run check:claude-md && npm run env:check && npm run crons:check",
    "env:example": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/env/generate-example.mts",
    "env:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/env/generate-example.mts --check",
    "crons:generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/crons/generate.mts",
    "crons:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/crons/generate.mts --check"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@google/genai": "1.50.1",
    "@hookform/resolvers": "5.2.2",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tabs": "1.1.13",
    "@react-pdf/renderer": "4.3.2",
    "@stripe/stripe-js": "9.4.0",
    "@supabase/ssr": "0.8.0",
    "@supabase/supabase-js": "2.95.2",
    "@tailwindcss/typography": "0.5.19",
    "@vercel/analytics": "2.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cron-parser": "5.5.0",
    "date-fns": "4.1.0",
    "lucide-react": "0.563.0",
    "next": "14.2.35",
    "openai": "6.18.0",
    "pdf-parse": "1.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.71.1",
    "recharts": "3.8.0",
    "resend": "6.9.2",
    "sharp": "0.34.5",
    "stripe": "22.1.1",
    "tailwind-merge": "3.4.0",
    "tailwindcss-animate": "1.0.7",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/eslint": "8.56.12",
    "@types/node": "20.19.32",
    "@types/pg": "8.15.6",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "8.54.0",
    "@typescript-eslint/parser": "8.54.0",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.5",
    "dotenv": "17.4.2",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jsdom": "29.0.2",
    "lint-staged": "16.4.0",
    "pg": "8.18.0",
    "postcss": "8.5.10",
    "prettier": "3.8.1",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  }
}
