# .env.example — GENERATED from src/modules/config/lib/env-schema.ts by `npm run env:example`; do not edit by hand
# (`npm run env:check` fails CI on drift — 06 §2.5, HANDOFF §5.4). Names only, never a value (07 §7): copy to
# .env.local and fill in. Marks per environment — dev · preview · prod: ● required · ○ optional · — absent.
# Booleans are the literal "true" (absent = the flag's code default — 01 §3.4). Provider bindings are closed enums.

# ── App ──
# ● dev · ● preview · ● prod (public) [url] — the one base URL (01 §3.1 urls.ts; prod = the London domain)
NEXT_PUBLIC_APP_URL=
# ● dev · ● preview · ● prod (public) [development | test | production] — set by tooling: development | test | production (absent = development)
NODE_ENV=
# ○ dev · ● preview · ● prod [development | preview | production] — set by Vercel: development | preview | production — selects the 06 §2.5 column
VERCEL_ENV=
# ● dev · ● preview · ● prod — Bearer for /api/cron/* (fail closed) — regenerated, never Sydney's
CRON_SECRET=
# ● dev · ● preview · ● prod — Bearer for the Recruitment Agent route (04.10) — regenerated
ADMIN_API_TOKEN=
# ● dev · ● preview · ● prod [uuid] — uuid of the London system account (02 §4.1; created by migration 0002)
SYSTEM_PARENT_ID=
# ● dev · ● preview · ● prod [email] — admin mailbox (config/senders.ts `admin`)
ADMIN_EMAIL=
# ● dev · ● preview · ● prod [email] — support mailbox (config/senders.ts `support`)
SUPPORT_INBOX=

# ── Supabase ──
# ● dev · ● preview · ● prod (public) [url] — project URL — local / bb-ldn-preview / bb-ldn-prod (ADR-066)
NEXT_PUBLIC_SUPABASE_URL=
# ● dev · ● preview · ● prod (public) — anon key (RLS applies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ● dev · ● preview · ● prod — service-role key — server scope only; named uses in module READMEs (07 §5.1 rule 5)
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ──
# ● dev · ● preview · ● prod [test | live] — test | live — key prefixes are asserted against it at boot (06 §2.2)
STRIPE_MODE=
# ● dev · ● preview · ● prod — restricted key with only the purchase-paths permissions (07 §7.5)
STRIPE_SECRET_KEY=
# ● dev · ● preview · ● prod (public) — publishable key (pk_test_ / pk_live_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# ● dev · ● preview · ● prod — signing secret for /api/webhooks/stripe (fail closed)
STRIPE_WEBHOOK_SECRET=
# ● dev · ● preview · ● prod — price id — self-serve app, upfront to age 3 (03 §5.2; never a literal)
STRIPE_PRICE_SELF_SERVE_APP_UPFRONT=
# ● dev · ● preview · ● prod — price id — self-serve app, monthly (03 §5.2; never a literal)
STRIPE_PRICE_SELF_SERVE_APP_MONTHLY=

# ── Providers ──
# ● dev · ● preview · ● prod [stripe-uk | stub-stripe] — stripe-uk | stub-stripe — the stub is refused in production (07 §5.5)
PURCHASE_PROVIDER=
# ○ dev · ○ preview · — prod — signs stub provider events; required iff stub-stripe, never in production (07 §5.5)
STUB_EVENT_SECRET=
# ● dev · ● preview · ● prod [resend | stub-email] — resend | stub-email (03 §8.1)
EMAIL_PROVIDER=
# ● dev · ● preview · ● prod [null-sms] — null-sms — the only value; no SMS day one (N-11, ADR-063)
SMS_PROVIDER=
# ● dev · ● preview · ● prod [db | stub] — db | stub — the areas connector binding (03 §6.3)
AREAS_SOURCE=

# ── Email ──
# ○ dev · ● preview · ● prod — Resend key scoped to the London domain; dev may omit under dry-run
RESEND_API_KEY=
# ● dev · — preview · — prod [boolean] — dev only: email_logs rows as dry_run, nothing sent (08.03)
EMAIL_DEV_DRY_RUN=

# ── AI ──
# ○ dev · ● preview · ● prod — project-scoped key, zero retention (07 §7.5)
OPENAI_API_KEY=
# ○ dev · ● preview · ● prod — Gemini key for Katie
GOOGLE_AI_API_KEY=
# ● dev · ● preview · ● prod [number] — daily Katie cost cap in USD (Gemini bills USD — 01 §1.2); read by config/katie.ts
KATIE_DAILY_LIMIT_USD=

# ── Analytics ──
# — dev · — preview · ● prod (public) — London pixel id
NEXT_PUBLIC_META_PIXEL_ID=
# — dev · — preview · ● prod — Conversions API token for the London dataset
META_CAPI_ACCESS_TOKEN=
# — dev · — preview · ● prod — London dataset id (≠ Sydney's — 08 §8 item 3)
META_DATASET_ID=

# ── Flags ──
# ● dev · ● preview · ● prod [boolean] — flag KATIE (server) — on everywhere; the app is the product
KATIE_ENABLED=
# ● dev · ● preview · ● prod (public) [boolean] — flag KATIE (client mirror)
NEXT_PUBLIC_KATIE_ENABLED=
# ● dev · ● preview · ● prod [boolean] — flag INVITE_LINKS — on (stage table row 8; ADR-031)
INVITE_LINKS_ENABLED=
# ● dev · ● preview · ● prod [boolean] — flag NEW_TRIALS — on (ADR-025 / 059)
NEW_TRIALS_ENABLED=
# ● dev · ● preview · ● prod [boolean] — flag PAYMENTS — on; kill switch only (06.11)
PAYMENTS_ENABLED=
# ○ dev · ○ preview · ○ prod [boolean] — flag BONUS_PROGRAM (server) — off in every environment (ADR-022 / 053 / 060)
BONUS_PROGRAM_ENABLED=
# ○ dev · ○ preview · ○ prod (public) [boolean] — flag BONUS_PROGRAM (client mirror) — off
NEXT_PUBLIC_BONUS_PROGRAM_ENABLED=
# ○ dev · ○ preview · ○ prod [boolean] — flag PROACTIVE (Katie) — value per 01 §10 O-5
PROACTIVE_ENABLED=

# ── Flags (dev) ──
# ○ dev · — preview · — prod (public) [boolean] — dev-mode auth bypass; honoured only when NODE_ENV !== production (01 §4d)
NEXT_PUBLIC_DEV_MODE=
# ○ dev · — preview · — prod (public) [boolean] — dev diagnostic (11.39)
NEXT_PUBLIC_SKIP_INTRO_WAIT=
# ○ dev · — preview · — prod (public) [boolean] — dev diagnostic (11.39)
NEXT_PUBLIC_FUNNEL_LOG=

# ── Flags (Katie) ──
# ○ dev · ○ preview · ○ prod [boolean] — Katie sub-flag (07.08)
KATIE_STREAM_DIAGNOSTICS=
# ○ dev · ○ preview · ○ prod [boolean] — Katie sub-flag (07.08)
KATIE_PRELOAD_PASSTHROUGH_ENABLED=
# ○ dev · ○ preview · ○ prod [boolean] — Katie sub-flag (07.08)
KATIE_PARALLEL_TOOLS_ENABLED=
# ○ dev · ○ preview · ○ prod [boolean] — Katie sub-flag (07.08)
KATIE_IMAGE_MARKER_ENABLED=
# ○ dev · ○ preview · ○ prod [boolean] — Katie sub-flag (07.08)
KATIE_ALWAYS_ON_CONTEXT_ENABLED=
# ○ dev · ○ preview · ○ prod (public) [boolean] — Katie sub-flag, client (07.08)
NEXT_PUBLIC_KATIE_TYPEWRITER_ENABLED=

# ── Monitoring ──
# — dev · ● preview · ● prod [url] — Sentry DSN, server (ADR-106)
SENTRY_DSN=
# — dev · ● preview · ● prod (public) [url] — Sentry DSN, client (ADR-106)
NEXT_PUBLIC_SENTRY_DSN=
# — dev · ● preview · ● prod [url] — Slack alert-channel webhook (06 §7.2; ADR-106)
ALERT_WEBHOOK_URL=
